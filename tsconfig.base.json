{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "exclude": [
    "**/node_modules",
    "**/dist",
    "**/test-results",
    "**/playwright-report",
    "**/allure-results",
    "**/blob-report"
  ]
}
