{
  "name": "dynamics-ui-automation-pipeline",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build:packages": "npm run build --workspaces --if-present",
    "discover": "npx bddgen && npx playwright test --list --reporter=json > test-manifest.json && node .ci/scripts/parse-test-list.js",
    "test": "playwright test",
    "bddgen": "bddgen"
  },
  "devDependencies": {
    "@playwright/test": "^1.42.0",
    "allure-playwright": "^3.0.0",
    "playwright-bdd": "^7.0.0",
    "typescript": "^5.4.0"
  }
}
